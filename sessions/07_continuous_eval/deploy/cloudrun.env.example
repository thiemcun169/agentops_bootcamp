# Copy to deploy/cloudrun.env, set PROJECT_ID, then load it in every new terminal:
#   set -a && source deploy/cloudrun.env && set +a
# Names used in every command of the README: region us-central1, repository agentops, service agent-api,
# Cloud SQL instance agent-pg, service account agent-api-runtime. No key in this file: keys go to Secret Manager.
PROJECT_ID=
IMAGE=us-central1-docker.pkg.dev/${PROJECT_ID}/agentops/agent-api:0.4.0
SA_EMAIL=agent-api-runtime@${PROJECT_ID}.iam.gserviceaccount.com
SQL_CONN=${PROJECT_ID}:us-central1:agent-pg
