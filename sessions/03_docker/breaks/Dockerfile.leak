# DO NOT DO THIS. Break step of Part 3: a key passed with ARG/ENV stays in the image.
# Build it with a FAKE key only:  docker build -f breaks/Dockerfile.leak --build-arg OPENAI_API_KEY=sk-FAKE-for-the-leak-demo-000 -t leak-demo breaks
FROM python:3.12-slim
ARG OPENAI_API_KEY
ENV OPENAI_API_KEY=$OPENAI_API_KEY
