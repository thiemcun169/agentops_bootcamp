# Copy to .env (in this folder) and fill in your keys. Never commit .env.
APP_ENV=dev
OPENAI_API_KEY=
TAVILY_API_KEY=
# A model ID from the "Snapshots" list of the model page (gpt-6-luna is its own snapshot).
MODEL=openai:gpt-6-luna
MAX_SEARCH_RESULTS=3
LOG_LEVEL=INFO
# Browser origins allowed to call the API (JSON list). Empty: only the UI served by the API itself (/ui).
CORS_ORIGINS=[]
# ── Session 03 ──
# memory: conversations are lost on restart. compose.yaml sets postgres (and DB_HOST=postgres) for agent-api.
CHECKPOINTER=memory
# Host port published by compose.yaml (the container always listens on 8000). Change it if 8000 is taken.
API_PORT=8000
